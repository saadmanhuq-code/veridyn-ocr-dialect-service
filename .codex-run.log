+                      <p className="bangla sample-phrase">
+                        {sample.phrase.slice(0, 120)}
+                        {sample.phrase.length > 120 ? "…" : ""}
+                      </p>
+                      <button type="button" className="btn-secondary btn-sm" onClick={() => applySample(sample)}>
