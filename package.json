{
  "name": "veridyn-ocr-dialect-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-build-info.mjs --allow-dirty",
    "dev": "next dev -p 3333",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "next build",
    "start": "next start -p 3333",
    "prelint": "node scripts/generate-build-info.mjs --allow-dirty",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "pretest": "node scripts/generate-build-info.mjs --allow-dirty",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "test:built-health": "node --test scripts/verify-built-health.test.mjs",
    "test:gate": "node --import tsx --test \"lib/integrity-auth-coverage.test.ts\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.67",
    "jszip": "^3.10.1",
    "next": "^15.5.21",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.6",
    "knip": "^6.18.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
